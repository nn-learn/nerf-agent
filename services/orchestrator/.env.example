# Safe zero-GPU defaults for the self-hosted Ollama voice demo.
# qwen3.6:latest is about 23 GB on the reference machine and is never silently
# replaced. To use qwen:latest, set that exact name here as an explicit choice.
PSYAVATAR_PROVIDER_MODE=local
PSYAVATAR_OLLAMA_BASE_URL=http://127.0.0.1:11434
PSYAVATAR_TEXT_MODEL=qwen3.6:latest
PSYAVATAR_OLLAMA_KEEP_ALIVE=30m
PSYAVATAR_OLLAMA_TIMEOUT_SECONDS=180
PSYAVATAR_OLLAMA_NUM_CTX=4096
PSYAVATAR_OLLAMA_NUM_PREDICT=320
# Memory extraction runs off the realtime reply path. Keep rule as the safe
# fallback; select ollama only after its gold-set report is acceptable.
PSYAVATAR_MEMORY_EXTRACTOR_MODE=rule
PSYAVATAR_MEMORY_OLLAMA_NUM_CTX=8192
PSYAVATAR_MEMORY_OLLAMA_NUM_PREDICT=1200
PSYAVATAR_MEMORY_EXTRACTION_CACHE_ENTRIES=256
PSYAVATAR_MEMORY_RULE_FALLBACK=true
PSYAVATAR_MEMORY_EXTRACTION_BATCH_TOKENS=4096
PSYAVATAR_MEMORY_EXTRACTION_BATCH_WINDOWS=8
PSYAVATAR_MEMORY_INGESTION_QUEUE_SIZE=128
# V2.1 semantic claim grouping remains rule-only by default. Ollama mode is
# background-only and fails back to exact deterministic grouping per batch.
PSYAVATAR_MEMORY_CLAIM_NORMALIZER_MODE=rule
PSYAVATAR_MEMORY_CLAIM_OLLAMA_TIMEOUT_SECONDS=60
PSYAVATAR_MEMORY_CLAIM_OLLAMA_NUM_CTX=4096
PSYAVATAR_MEMORY_CLAIM_OLLAMA_NUM_PREDICT=800
PSYAVATAR_MEMORY_CLAIM_OLLAMA_CACHE_ENTRIES=256
PSYAVATAR_MEMORY_CLAIM_OLLAMA_BATCH_CLAIMS=32
PSYAVATAR_MEMORY_EPISODE_SUMMARY_ENABLED=true
PSYAVATAR_MEMORY_EPISODE_MAX_MEMBERS=6
PSYAVATAR_MEMORY_EPISODE_MAX_CHARS=800
PSYAVATAR_MEMORY_EPISODE_TIME_GAP_MINUTES=30
PSYAVATAR_MEMORY_FRESHNESS_RERANK_ENABLED=true
PSYAVATAR_MEMORY_FRESHNESS_MINIMUM_FACTOR=0.90
# V1.6 shadow retrieval is opt-in twice: the deployment flag must be enabled,
# and each user must grant the versioned research consent in Memory Center.
# It never changes the realtime answer and stores no query, text, or embedding.
PSYAVATAR_MEMORY_SHADOW_ENABLED=false
PSYAVATAR_MEMORY_SHADOW_POLICY_VERSION=memory-shadow-research-v1
PSYAVATAR_MEMORY_SHADOW_STRATEGY_VERSION=hybrid-bge-m3-v1.6@0.50
PSYAVATAR_MEMORY_SHADOW_SEMANTIC_MIN_RELEVANCE=0.50
PSYAVATAR_MEMORY_SHADOW_TIMEOUT_SECONDS=15
PSYAVATAR_MEMORY_SHADOW_INITIALIZATION_TIMEOUT_SECONDS=120
PSYAVATAR_MEMORY_SHADOW_FAILURE_THRESHOLD=3
PSYAVATAR_MEMORY_SHADOW_COOLDOWN_SECONDS=60
PSYAVATAR_MEMORY_SHADOW_MAX_CONCURRENCY=1
PSYAVATAR_MEMORY_SHADOW_MAX_PENDING=16
PSYAVATAR_MEMORY_SHADOW_RETENTION_DAYS=30
PSYAVATAR_MEMORY_SHADOW_MIN_RELIABLE_RUNS=100
PSYAVATAR_KNOWLEDGE_MANIFEST_PATH=../../knowledge/manifest.yaml
PSYAVATAR_RAG_TOP_K=3
PSYAVATAR_RAG_EVIDENCE_THRESHOLD=0.62
PSYAVATAR_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
PSYAVATAR_UTTERANCE_END_SILENCE_MS=600
PSYAVATAR_UTTERANCE_MAX_MS=20000
PSYAVATAR_STT_MODEL=small
PSYAVATAR_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Local mode skips LiveKit, the avatar worker and CUDA. These development-only
# LiveKit values are read only by the explicitly selected real mode.
PSYAVATAR_LIVEKIT_URL=ws://localhost:7880
PSYAVATAR_LIVEKIT_API_KEY=devkey
PSYAVATAR_LIVEKIT_API_SECRET=secret-with-at-least-32-characters
PSYAVATAR_WEB_ORIGIN=http://localhost:5173
PSYAVATAR_EVENT_DATABASE_PATH=runtime/events.sqlite3
PSYAVATAR_REQUEST_RATE_LIMIT_PER_MINUTE=120

# Edge TTS requires network access. BGE-M3 may download on first retrieval.
# Raw microphone/video/media bytes are kept in memory and are not persisted.
# Configure the cloud credential only for explicit real-mode experiments and
# only after rotating any legacy plaintext key.
# PSYAVATAR_DASHSCOPE_API_KEY=
