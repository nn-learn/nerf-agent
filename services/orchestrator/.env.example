# Safe local defaults for the self-hosted Ollama and LiveKit demo.
PSYAVATAR_PROVIDER_MODE=local
PSYAVATAR_OLLAMA_BASE_URL=http://127.0.0.1:11434
PSYAVATAR_TEXT_MODEL=qwen3.6:latest
PSYAVATAR_OLLAMA_KEEP_ALIVE=30m
PSYAVATAR_OLLAMA_TIMEOUT_SECONDS=180
PSYAVATAR_OLLAMA_NUM_CTX=4096
PSYAVATAR_OLLAMA_NUM_PREDICT=320
PSYAVATAR_KNOWLEDGE_MANIFEST_PATH=../../knowledge/manifest.yaml
PSYAVATAR_RAG_TOP_K=3
PSYAVATAR_RAG_EVIDENCE_THRESHOLD=0.62
PSYAVATAR_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
PSYAVATAR_UTTERANCE_END_SILENCE_MS=600
PSYAVATAR_UTTERANCE_MAX_MS=20000
PSYAVATAR_LIVEKIT_URL=ws://localhost:7880
PSYAVATAR_LIVEKIT_API_KEY=devkey
PSYAVATAR_LIVEKIT_API_SECRET=secret-with-at-least-32-characters
PSYAVATAR_WEB_ORIGIN=http://localhost:5173
PSYAVATAR_EVENT_DATABASE_PATH=runtime/events.sqlite3
PSYAVATAR_REQUEST_RATE_LIMIT_PER_MINUTE=120

# Configure only after rotating any legacy plaintext key.
# PSYAVATAR_DASHSCOPE_API_KEY=
