# Choose mock, local (Ollama + browser PCM), or livekit explicitly.
# mock works without LiveKit, cloud credentials, Ollama, or a GPU.
# start-demo.ps1 sets this automatically; use local for manual zero-GPU runs.
# Local WebSocket URLs are derived from VITE_API_BASE_URL.
VITE_MEDIA_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
